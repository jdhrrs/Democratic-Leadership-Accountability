/********************************************************
 SEND ONE EMAIL
********************************************************/

function sendHourlyEmail() {
  const properties = PropertiesService.getScriptProperties();

  const index = Number(
    properties.getProperty("messageIndex") || 0
  );

  const subject = SUBJECTS[index];
  const message = MESSAGES[index];

  GmailApp.sendEmail(
    RECIPIENTS.join(","),
    subject,
    message
  );

  properties.setProperty(
    "messageIndex",
    String((index + 1) % MESSAGES.length)
  );
}

/********************************************************
 START HOURLY SCHEDULE
********************************************************/

function startCampaign() {

  stopCampaign();

  ScriptApp.newTrigger("sendHourlyEmail")
    .timeBased()
    .everyHours(1)
    .create();

}

/********************************************************
 STOP AUTOMATED SENDING
********************************************************/

function stopCampaign() {

  ScriptApp.getProjectTriggers().forEach(trigger => {

    if (
      trigger.getHandlerFunction() === "sendHourlyEmail"
    ) {
      ScriptApp.deleteTrigger(trigger);
    }

  });

}
