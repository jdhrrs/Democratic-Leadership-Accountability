const MAX_EMAILS = 480;

function sendHourlyEmaiL() {
  const properties = PropertiesService.getScriptProperties();
  let totalSent = Number(properties.getProperty("messageIndex") || 0);
  const batchNumber = Math.floor(totalSent / RECIPIENT.length);

  if (totalSent >= MAX_EMAILS) {
    Logger.log("Reached MAX_EMAILS (" + MAX_EMAILS + "). Stopping triggers.");
    stopCampaigN();
    return;
  }

  for (let i = 0; i < RECIPIENT.length; i++) {
    if (totalSent >= MAX_EMAILS) {
      break;
    }

    const recipient = RECIPIENT[i];
    // Rotate subject & message across both recipients and hours
    const subject = SUBJECT[(i + batchNumber) % SUBJECT.length];
    const body = MESSAGE[(i + batchNumber) % MESSAGE.length];

    GmailApp.sendEmail(recipient, subject, body);
    totalSent++;
    Utilities.sleep(500); // Half-second pause between sends to prevent rate-limiting
  }

  properties.setProperty("messageIndex", String(totalSent));
  Logger.log("Hourly batch complete. Total emails sent so far: " + totalSent + " / " + MAX_EMAILS);

  if (totalSent < MAX_EMAILS) {
    scheduleNextTopOfHour();
  } else {
    Logger.log("Campaign finished! Reached MAX_EMAILS.");
    stopCampaigN();
  }
}

function scheduleNextTopOfHour() {
  stopCampaigN(); // Remove previous one-off trigger

  const now = new Date();
  const nextHour = new Date(now);
  nextHour.setHours(now.getHours() + 1, 0, 0, 0); // Lock to the exact :00:00 mark

  ScriptApp.newTrigger("sendHourlyEmaiL")
    .timeBased()
    .at(nextHour)
    .create();

  Logger.log("Next batch scheduled for: " + nextHour.toString());
}

function startCampaigN() {
  stopCampaigN();
  PropertiesService.getScriptProperties().setProperty("messageIndex", "0");

  // Sends Batch 1 immediately and schedules the rest on the hour (:00).
  // To wait until the next :00 before sending Batch 1, replace sendHourlyEmaiL() below with scheduleNextTopOfHour().
  sendHourlyEmaiL();
}

function stopCampaigN() {
  ScriptApp.getProjectTriggers().forEach(trigger => {
    if (trigger.getHandlerFunction() === "sendHourlyEmaiL") {
      ScriptApp.deleteTrigger(trigger);
    }
  });
  Logger.log("Campaign triggers stopped.");
}

function checkStatus() {
  const count = PropertiesService.getScriptProperties().getProperty("messageIndex") || "0";
  Logger.log("Total Emails Sent: " + count + " / " + MAX_EMAILS);
}
